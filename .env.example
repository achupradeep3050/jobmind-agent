# JobMind Environment Configuration
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit your actual .env file to version control!
# Both .env and .env.local are already in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# BLACKBOX API Configuration (Kimi K2.6)
# Uses Kimi model via Blackbox - no OpenAI needed!
# Get your key at: https://blackbox.ai (free tier available)
# -----------------------------------------------------------------------------
BLACKBOX_API_KEY=your_blackbox_api_key_here